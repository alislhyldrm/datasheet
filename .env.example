# Anthropic API anahtarı (zorunlu) — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Uygulamanın önündeki HTTP Basic auth şifresi. Kullanıcı adı önemsiz.
# Boş bırakılırsa: geliştirmede kapı açılmaz, production'da sunucu 500 döner.
# Üretmek için: node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
APP_PASSWORD=

# 4 MB üstü PDF yüklemesi için gerekli; küçük PDF'ler bu olmadan çalışır.
# Private bir Blob store oluşturunca otomatik eklenir:
#   vercel blob create-store <ad> --access private --yes
# Dikkat: bu komut .env.local'ı yeniden yazar ve Vercel'in development
# ortamında bulunmayan değişkenleri (ör. ANTHROPIC_API_KEY) siler. Önce yedekle.
# BLOB_READ_WRITE_TOKEN=
