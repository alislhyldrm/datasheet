# Bu dosya isteğe bağlı. Sağlayıcıyı, modeli ve anahtarı uygulama içindeki
# "Model ayarları"ndan da girebilirsin (anahtar tarayıcıda kalır).
#
# Buradaki anahtar sunucunun kendi varsayılanıdır: tarayıcıda anahtar
# tanımlıysa o kullanılır, tanımlı değilse uygulama bu dosyaya düşer. e2e test
# de bunu kullanır.
#
# Kullanmak için: cp .env.example .env.local ve KULLANDIĞIN SAĞLAYICININ
# ANAHTARINI DOLDUR. Tek satır yeter; sağlayıcı hangisiyse ondan anlaşılır.
# Birden fazlasını doldurabilirsin: uygulama içinden hangi sağlayıcıya geçersen
# geç anahtarı hazır olur.

# Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Aşağıdaki iki satır yalnızca uygulama içindeki "Model ayarları" hiç
# kaydedilmediğinde kullanılır; panelden bir seçim yaptıysan o kazanır.

# Yukarıda BİRDEN FAZLA anahtar doluysa hangisiyle başlanacağını söyler.
# anthropic | openai | gemini
LLM_PROVIDER=

# Başlangıç modeli. Boş bırakılırsa sağlayıcının varsayılan modeli kullanılır.
LLM_MODEL=
